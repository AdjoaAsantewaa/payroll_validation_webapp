# Local dev (default if DATABASE_URL is unset): SQLite, auto-created on startup.
# DATABASE_URL=sqlite:///./payroll.db

# Production (Vercel): Supabase Postgres, "Transaction" pooler connection string
# (Project Settings -> Database -> Connection string -> Transaction pooler,
# port 6543) — required for a serverless environment. Do not use the direct
# (port 5432) connection string in production; see README for why.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres

JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=480
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
